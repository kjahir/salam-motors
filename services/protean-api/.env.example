# Where this service listens. The container exposes 8080.
PORT=8080

# Browser origins allowed to call /esign and /lookup. Comma-separated, no trailing slash.
# Leave blank ONLY if the service is unreachable from the public internet.
ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- Supabase -----------------------------------------------------------------
# The same project the frontend talks to. The anon key is used to build a
# caller-scoped client so RLS still applies to every read.
SUPABASE_URL=https://swgxitzcylokelhqlcfe.supabase.co
SUPABASE_ANON_KEY=
# Needed to store generated agreements and to apply webhook updates that arrive with
# no user session. Treat this as the most sensitive value here.
SUPABASE_SERVICE_ROLE_KEY=

# --- Protean e-Sign Pro -------------------------------------------------------
# Defaults to the host matching PROTEAN_ENV; set explicitly to override.
PROTEAN_API_BASE_URL=https://uat.risewithprotean.io
PROTEAN_ENV=sandbox
PROTEAN_API_KEY=
# With or without the leading "Bearer " — both are accepted.
PROTEAN_BEARER_TOKEN=
# The eSign Pro portal login, repeated in every request body (guide §3).
PROTEAN_LOGIN_ID=
PROTEAN_LOGIN_PASSWORD=
# Salt configured under Settings -> eSign -> Webhook. At least 16 characters.
PROTEAN_WEBHOOK_SECRET=
# Decides which eStamp fields Protean requires. NonLoan-Individual suits a dealer
# selling to individual buyers.
PROTEAN_ORG_REG_TYPE=NonLoan-Individual
PROTEAN_TIMEOUT_MS=30000

# Lookup cache window, in minutes (default 60, max 1440).
PROTEAN_LOOKUP_CACHE_TTL_MINUTES=60
