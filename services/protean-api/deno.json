{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch src/main.ts",
    "start": "deno run --allow-net --allow-env src/main.ts",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "fmt": {
    "lineWidth": 96,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
